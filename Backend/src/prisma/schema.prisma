
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  open
  in_progress
  closed
}

enum TicketPriority {
  low
  medium
  high
}


model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("tickets")
}